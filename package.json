{
  "name": "sussurro",
  "version": "0.0.0",
  "private": true,
  "description": "Rede social sem algoritmo: app Expo e API + worker NestJS.",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=26.13 <27",
    "pnpm": ">=12.13 <13"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@sussurro/mobile",
    "dev:mobile": "pnpm --filter @sussurro/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:cov": "turbo run test:cov",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test",
    "db:generate": "pnpm --filter @sussurro/db db:generate",
    "db:migrate": "pnpm --filter @sussurro/db db:migrate",
    "db:seed": "pnpm --filter @sussurro/db db:seed",
    "db:studio": "pnpm --filter @sussurro/db db:studio",
    "db:pglite": "pnpm --filter @sussurro/db db:pglite",
    "spike:aws": "node --env-file-if-exists=.env infra/local/spike-aws.mts",
    "lint:root": "eslint --max-warnings 0 infra scripts eslint.config.mjs",
    "typecheck:root": "tsc -p infra/tsconfig.json",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "26.6.6",
    "eslint": "10.13.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  }
}
