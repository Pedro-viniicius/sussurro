# Copie para .env (na raiz) e ajuste. Lido pelo docker compose, pela API e pelo worker.
# Sem segredos: os valores abaixo são só de desenvolvimento local (infra.md §3.4).
# O app tem o próprio arquivo: apps/mobile/.env.example (EXPO_PUBLIC_*).

# --- geral ---
NODE_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=3000
# Fase 2: janela do feed em horas (inteiro de 1 a 720). Ausente = 72; valor inválido ou vazio
# impede a API de subir (FEED-03b).
FEED_WINDOW_HOURS=72

# --- conexão presencial (Fase 4, ADR 0003; em segundos) ---
# Token de proximidade: válido 30 s (resolve e pedido), recente 120 s (só o aceite); a tela
# Conectar conta como aberta por 30 s a cada token emitido. Pedido pendente vale 120 s; depois de
# uma recusa, quem pediu espera 1 h para pedir de novo à mesma pessoa.
PROX_TOKEN_TTL_S=30
PROX_RECENT_TTL_S=120
PROX_SCREEN_TTL_S=30
CONNECTION_REQUEST_TTL_S=120
CONNECTION_DECLINE_COOLDOWN_S=3600
# Onde ficam os tokens: redis (padrão, obrigatório em produção; sem Valkey, Conectar responde 503)
# ou memory (só desenvolvimento sem Docker: memória da API, uma instância, some ao reiniciar).
PROXIMITY_STORE=redis

# --- banco e redis (credencial só local, não é segredo) ---
POSTGRES_PASSWORD=sussurro
DATABASE_URL=postgres://sussurro:sussurro@localhost:5432/sussurro
REDIS_URL=redis://localhost:6379

# --- AWS (dev: emuladores ElasticMQ + SeaweedFS; prod: vazio = AWS real com IAM role) ---
# Usado a partir da Fase 2.
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_SQS=http://localhost:9324
AWS_ENDPOINT_URL_S3=http://localhost:8333
# Com LocalStack: troque as duas linhas acima por AWS_ENDPOINT_URL=http://localhost:4566
# e preencha LOCALSTACK_AUTH_TOKEN.
LOCALSTACK_AUTH_TOKEN=
S3_FORCE_PATH_STYLE=true
# IP do PC na LAN: a URL pré-assinada é usada pelo celular.
S3_PUBLIC_ENDPOINT_URL=http://192.168.0.10:8333
S3_BUCKET_MEDIA=sussurro-media
SQS_QUEUE_MEDIA_JOBS=media-jobs
SQS_QUEUE_VIDEO_EVENTS=video-events
SQS_QUEUE_PUSH=push

# --- mídia (Fases 2 e 5) ---
# Leitura da mídia: s3-presign (dev, GET pré-assinado no SeaweedFS) ou cloudfront (produção).
MEDIA_URL_SIGNER=s3-presign
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# PEM numa linha só, com \n no lugar das quebras (prod: Secrets Manager). Para testar o formato do
# CloudFront em dev, gere uma chave local (nada é baixado):
#   node -e "const {privateKey}=require('node:crypto').generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log(privateKey.replace(/\n/g,'\\n'))"
CLOUDFRONT_PRIVATE_KEY=
# Validade da URL PUT pré-assinada (10 min) e das URLs de leitura (6 h, A-19), em segundos.
PRESIGN_PUT_TTL_S=600
MEDIA_URL_TTL_S=21600

# --- worker: vídeo dos reels (Fase 5, ADR 0006) ---
# passthrough (dev e testes: copia o vídeo e usa o poster do app; mantém os metadados do original,
# inclusive a localização, por isso o worker não sobe com ele em produção) ou mediaconvert
# (AWS MediaConvert, obrigatório em produção). Outro valor impede o worker de subir.
# Em dev, publique só vídeos de teste sem localização (A-21).
VIDEO_PROCESSOR=passthrough
# Com mediaconvert: role de serviço do MediaConvert (obrigatória) e a fila dele (vazio = Default).
MEDIACONVERT_ROLE_ARN=
MEDIACONVERT_QUEUE_ARN=
# A fila video-events (EventBridge → SQS) é a SQS_QUEUE_VIDEO_EVENTS, acima.

# --- worker: fila media-jobs e limpeza (Fase 2) ---
# Mensagens processadas ao mesmo tempo, long polling (s) e tentativas (= maxReceiveCount da DLQ).
MEDIA_JOBS_CONCURRENCY=2
MEDIA_JOBS_WAIT_S=20
MEDIA_JOBS_MAX_ATTEMPTS=3
# Teto de pixels de uma imagem (bomba de descompressão vira failed, MID-06).
MEDIA_MAX_INPUT_PIXELS=40000000
# Rascunhos e uploads de avatar abandonados saem depois disto (2.11); mídia presa em processing
# vira failed depois deste tempo (minutos).
DRAFT_TTL_HOURS=24
MEDIA_PROCESSING_TIMEOUT_MIN=60

# --- auth (Fase 1, ADR 0007) ---
# Obrigatório. Gere um valor aleatório (nunca commitar):
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_KID=k1
# Rotação de segredo: o anterior continua aceito na verificação até os tokens antigos vencerem.
JWT_ACCESS_PREVIOUS_SECRET=
JWT_ACCESS_PREVIOUS_KID=
# Validades e janelas em segundos (A-27).
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
REFRESH_REUSE_GRACE_S=20
EMAIL_VERIFICATION_TTL_S=86400
PASSWORD_RESET_TTL_S=3600
# Proxies confiáveis à frente da API (ALB = 1); define o IP usado no rate limit.
TRUST_PROXY_HOPS=0

# --- e-mail (Fase 1, D6) ---
# log: escreve o e-mail (e o link) no log da API. ses: AWS SES (obrigatório em produção).
EMAIL_SENDER=log
EMAIL_FROM=Sussurro <nao-responda@sussurro.app>
# Início dos links dos e-mails: deep link do app em dev; domínio https em produção (Fase 7).
EMAIL_LINK_BASE_URL=sussurro://
# Fase 3 (X.1): fila de moderação mínima. Cada denúncia manda um e-mail para este endereço.
# Obrigatória em produção; vazia em dev = moderacao@example.com (com EMAIL_SENDER=log, só no log).
MODERATION_EMAIL=

# --- worker: manutenção (Fase 1) ---
# Hard delete das contas excluídas depois de N dias (máximo 30) e intervalo do job.
ACCOUNT_PURGE_AFTER_DAYS=30
MAINTENANCE_INTERVAL_MS=3600000

# --- observabilidade (Sentry completo e OpenTelemetry na Fase 6) ---
# Vazio = Sentry desligado: nada é inicializado nem enviado (decisão D4). Nunca commitar um DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
# Release dos eventos (o CI passa o SHA). Vazio = o SDK tenta descobrir.
SENTRY_RELEASE=
# Amostragem do tracing, de 0 (desligado) a 1.
SENTRY_TRACES_SAMPLE_RATE=0
# Pontos de OpenTelemetry (6.8): false = nenhum span nem exportador; o traceId vai para o log assim
# mesmo. true = spans pelo @opentelemetry/api (no-op sem SDK; com o Sentry, entram nele).
OTEL_ENABLED=false

# --- push (Fase 6, ADR 0011) ---
# A fila é a SQS_QUEUE_PUSH, acima. log (dev: o texto e o token mascarado no log do worker, nada sai
# da máquina) ou expo (Expo Push Service; obrigatório em produção).
PUSH_SENDER=log
# Só se a "segurança reforçada" de push estiver ligada no projeto do Expo. Segredo: nunca commitar.
EXPO_ACCESS_TOKEN=
# Mensagens da fila push por rodada (até 10), tentativas (= maxReceiveCount da push-dlq) e o
# intervalo da consulta dos recibos do Expo (ms).
PUSH_JOBS_CONCURRENCY=10
PUSH_JOBS_MAX_ATTEMPTS=3
PUSH_RECEIPTS_INTERVAL_MS=900000
