{
  "name": "@sussurro/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker do Sussurro (NestJS application context, ESM): fila media-jobs (sharp) e jobs de manutenção e limpeza.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run -c vitest.int.config.ts",
    "seed:media": "node dist/scripts/seed-media.js",
    "clean": "rimraf dist coverage .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-mediaconvert": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sqs": "3.1152.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@opentelemetry/api": "1.10.0",
    "@sentry/nestjs": "^11.10.0",
    "@sussurro/db": "workspace:*",
    "@sussurro/shared": "workspace:*",
    "expo-server-sdk": "8.0.0",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@sussurro/config": "workspace:*",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
