# Copie para apps/mobile/.env. Tudo que começa com EXPO_PUBLIC_ vai em texto claro para
# dentro do bundle do app: nunca coloque segredos aqui (infra.md §5.1).

# Fase 1: IP do PC na LAN (o celular precisa alcançar a API).
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
# Vazio = Sentry desligado (decisão D4).
EXPO_PUBLIC_SENTRY_DSN=
# Fase 6: amostragem do tracing do Sentry no app, de 0 (desligado) a 1. Vazio ou inválido = 0.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# "1" libera as rotas /dev (catálogo) fora do modo de desenvolvimento. Nunca no perfil production.
EXPO_PUBLIC_DEV_TOOLS=
# development | preview | production (muda o bundle id, o nome e as exceções de rede local).
APP_VARIANT=development

# --- só no build (EAS Environment Variables; não vão para o bundle) ---
# Fase 6: troca o projeto do EAS (expo.dev). Vazio = o projeto fixo no app.config.ts (EAS_PROJECT_ID).
EAS_PROJECT_ID=
# Fase 6: caminho do google-services.json do Firebase (FCM do Android). No EAS, variável do tipo
# arquivo; o arquivo nunca entra no repositório.
GOOGLE_SERVICES_JSON=
# Fase 6: upload dos source maps no EAS Build. O SENTRY_AUTH_TOKEN é secret do EAS (visibilidade
# "secret") e nunca fica aqui nem no repositório; sem ele (ou sem org/projeto) o upload fica
# desligado e o build não falha.
SENTRY_ORG=
SENTRY_PROJECT=
