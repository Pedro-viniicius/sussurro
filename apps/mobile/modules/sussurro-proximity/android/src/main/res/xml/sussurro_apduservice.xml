<?xml version="1.0" encoding="utf-8"?>
<!-- AID da aplicação NDEF do NFC Forum Type 4 Tag (ADR 0013 §4), categoria "other". O sistema só
     chama o serviço com o aparelho desbloqueado. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/sussurro_nfc_service_description"
  android:requireDeviceUnlock="true">
  <aid-group
    android:category="other"
    android:description="@string/sussurro_nfc_aid_group_description">
    <aid-filter android:name="D2760000850101" />
  </aid-group>
</host-apdu-service>
